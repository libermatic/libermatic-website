---
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>Astro + Tailwind</title>
  </head>
  <body class="min-h-screen bg-gray-950 text-white flex flex-col items-center justify-center">
    <main class="text-center px-6">
      <h1 class="text-5xl font-bold bg-gradient-to-r from-blue-400 to-purple-500 bg-clip-text text-transparent mb-4">
        Astro + Tailwind
      </h1>
      <p class="text-gray-400 text-lg mb-8">
        Your new project is ready. Start editing to see your changes live!
      </p>
      <a
        href="https://docs.astro.build"
        target="_blank"
        class="inline-block px-6 py-3 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-medium transition-colors"
      >
        Read the Docs
      </a>
    </main>
  </body>
</html>
