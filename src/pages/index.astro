            </a>
            <a href="#" class="w-10 h-10 border-2 border-brutal-white flex items-center justify-center hover:bg-brutal-accent hover:border-brutal-accent hover:text-brutal-black transition-colors hard-shadow-sm" aria-label="Twitter">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </a>
          </div>
        </div>
        <hr class="accent-hr mt-8 mb-6" />
        <p class="mono-meta text-brutal-gray text-xs uppercase tracking-wider">
