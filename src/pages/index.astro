            <span>© {new Date().getFullYear()} BUILD CO.</span>
            <span class="hidden sm:inline">|</span>
            <span>SYS:v2.4.1</span>
            <span class="hidden sm:inline">|</span>
            <span>MEM:4.2mb</span>
          </div>
          <div class="flex gap-4">
            <a href="#" class="w-10 h-10 border-2 border-brutal-white flex items-center justify-center hover:bg-brutal-accent hover:border-brutal-accent hover:text-brutal-black transition-colors hard-shadow-sm" aria-label="GitHub">
