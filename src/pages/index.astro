---
import '../styles/global.css';

const meta = {
  status: '[SYSTEM_ONLINE: 99.9%]',
  timezone: new Date().toLocaleString('en-US', { timeZoneName: 'short' }).split(' ').slice(-1)[0],
  capacity: '[CAPACITY: AVAILABLE]',
  version: 'v2.4.1',
  loadTime: '12ms'
};

const services = [
  {
    icon: '//',
    title: 'Custom Web Apps',
    bullets: ['[x] SPA / SSA architectures', '[x] State management & data flows', '[x] Component systems & design tokens', '[x] Accessibility (WCAG 2.1 AA+)']
  },
  {
    icon: '->',
    title: 'API Engineering',
    bullets: ['[x] REST & GraphQL endpoints', '[x] Authentication & rate limiting', '[x] Database modeling & migrations', '[x] Webhook & event-driven systems']
  },
  {
    icon: '[x]',
    title: 'Performance Optimization',
    bullets: ['[x] Core Web Vitals auditing', '[x] Bundle analysis & tree-shaking', '[x] Caching strategies & edge delivery', '[x] Lighthouse score: 100/100 target']
  },
  {
    icon: '//',
    title: 'Infrastructure',
    bullets: ['[x] CI/CD pipeline design', '[x] Container orchestration', '[x] Monitoring & observability', '[x] Auto-scaling & load balancing']
  }
];

const projects = [
  {
    name: 'NEXUS / DASHBOARD',
    category: 'WEB APP',
    stats: { lighthouse: 100, loadTime: '120ms', bundleSize: '42kb' },
    desc: 'Real-time analytics dashboard. Zero dependencies. Pure SSR.'
  },
  {
    name: 'FORGE / E-COMMERCE',
    category: 'FULL STACK',
    stats: { lighthouse: 100, loadTime: '89ms', bundleSize: '38kb' },
    desc: 'Headless commerce platform. Sub-100ms TTFB across all regions.'
  },
  {
    name: 'PULSE / HEALTH-API',
    category: 'API ENGINEERING',
    stats: { lighthouse: 100, loadTime: '45ms', bundleSize: 'N/A' },
    desc: 'HIPAA-compliant API handling 2M+ daily requests at 99.99% uptime.'
  }
];

const manifesto = [
  "We don't build websites. We build systems. Every pixel is intentional, every line of code is accountable, and every interaction is engineered to perform under real-world conditions. The modern web is bloated with framework bloat, unnecessary abstractions, and design patterns that prioritize aesthetics over substance. We reject that.",

  "Our approach is radical in its simplicity: raw HTML served at the speed of light, CSS that doesn't need a build step to work, and JavaScript only when the user actually needs interactivity. We strip away the ceremony and deliver applications that load instantly, render predictably, and degrade gracefully. This isn't minimalism for the sake of minimalism — it's engineering discipline applied to the web platform.",

  "We work with founders, technical teams, and organizations who understand that the best technology is the technology that gets out of the way. If your project demands performance that matters, accessibility that's real, and code that your team can maintain without a 47-slide onboarding deck — let's talk. We build for the long haul, not the demo day."
];

const contactLines = [
  '$ echo "INITIATE PROJECT"',
  '',
  '> Name:        [input]',
  '> Email:       [input]',
  '> Project:     [input]',
  '> Budget:      [input]',
  '',
  '$> Sending...',
  '',
  '> Connection established. We reply within 24h.'
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="We build fast, unbreakable web systems. Custom web apps, API engineering, performance optimization, and infrastructure." />
    <title>BUILD CO. — Fast, Unbreakable Web Systems</title>
    <style>
      /* Hard offset shadow utility */
      .hard-shadow {
        box-shadow: 6px 6px 0px #000;
      }
      .hard-shadow-sm {
        box-shadow: 3px 3px 0px #000;
      }
      /* Instant hover inversion */
      .brutal-hover {
        transition: none;
      }
      .brutal-hover:hover {
        transition: none;
      }
      /* Monospace metadata */
      .mono-meta {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.75rem;
        letter-spacing: 0.05em;
      }
      /* Grid overlay pattern */
      .grid-lines {
        background-image:
          linear-gradient(to right, rgba(255,255,255,0.03) 1px, transparent 1px),
          linear-gradient(to bottom, rgba(255,255,255,0.03) 1px, transparent 1px);
        background-size: 60px 60px;
      }
      /* Terminal cursor blink */
      @keyframes blink {
        0%, 100% { opacity: 1; }
        50% { opacity: 0; }
      }
      .cursor-blink::after {
        content: '█';
        animation: blink 1s step-end infinite;
        margin-left: 2px;
      }
      /* Horizontal rule accent */
      .accent-hr {
        height: 4px;
        background: #CCFF00;
        border: none;
      }
    </style>
  </head>
  <body class="bg-brutal-black text-brutal-white font-sans antialiased overflow-x-hidden">

    <!-- ═══════════════════ NAVIGATION ═══════════════════ -->
    <nav class="fixed top-0 left-0 right-0 z-50 border-b-4 border-brutal-white bg-brutal-black">
      <div class="max-w-7xl mx-auto flex items-center justify-between px-4 sm:px-6 lg:px-8 h-16">
        <a href="/" class="font-display font-bold text-xl sm:text-2xl tracking-tight flex items-center gap-2">
          <span class="inline-block w-3 h-3 bg-brutal-accent border-2 border-brutal-white"></span>
          BUILD<span class="text-brutal-accent">.</span>CO
        </a>
        <div class="hidden sm:flex items-center gap-8">
          <a href="#services" class="font-mono text-sm uppercase tracking-wider hover:text-brutal-accent transition-colors">Services</a>
          <a href="#work" class="font-mono text-sm uppercase tracking-wider hover:text-brutal-accent transition-colors">Work</a>
          <a href="#philosophy" class="font-mono text-sm uppercase tracking-wider hover:text-brutal-accent transition-colors">Philosophy</a>
          <a href="#contact" class="font-mono text-sm uppercase tracking-wider hover:text-brutal-accent transition-colors">Contact</a>
        </div>
        <!-- Mobile menu button -->
        <button class="sm:hidden w-10 h-10 border-2 border-brutal-white flex items-center justify-center hover:bg-brutal-accent hover:border-brutal-accent hover:text-brutal-black transition-colors" onclick="this.nextElementSibling.classList.toggle('hidden')">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="2" y1="5" x2="18" y2="5"/><line x1="2" y1="10" x2="18" y2="10"/><line x1="2" y1="15" x2="18" y2="15"/>
          </svg>
        </button>
        <!-- Mobile menu -->
        <div class="hidden absolute top-16 left-0 right-0 border-b-4 border-r-4 border-l-4 border-brutal-white bg-brutal-black p-4 sm:hidden">
          <div class="flex flex-col gap-4">
            <a href="#services" class="font-mono text-sm uppercase tracking-wider hover:text-brutal-accent py-2 border-b-2 border-brutal-dark-gray">Services</a>
            <a href="#work" class="font-mono text-sm uppercase tracking-wider hover:text-brutal-accent py-2 border-b-2 border-brutal-dark-gray">Work</a>
            <a href="#philosophy" class="font-mono text-sm uppercase tracking-wider hover:text-brutal-accent py-2 border-b-2 border-brutal-dark-gray">Philosophy</a>
            <a href="#contact" class="font-mono text-sm uppercase tracking-wider hover:text-brutal-accent py-2">Contact</a>
          </div>
        </div>
      </div>
    </nav>

    <!-- ═══════════════════ HERO SECTION ═══════════════════ -->
    <header class="relative min-h-screen flex flex-col justify-center border-b-4 border-brutal-white grid-lines pt-16">
      <div class="max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-12 sm:py-20">

        <!-- Metadata bar -->
        <div class="flex flex-wrap gap-3 sm:gap-4 mb-8 sm:mb-12">
          <span class="mono-meta px-3 py-1 border-2 border-brutal-accent text-brutal-accent">{meta.status}</span>
          <span class="mono-meta px-3 py-1 border-2 border-brutal-white text-brutal-white">{meta.timezone}</span>
          <span class="mono-meta px-3 py-1 border-2 border-brutal-white text-brutal-white">{meta.capacity}</span>
          <span class="mono-meta px-3 py-1 border-2 border-brutal-dark-gray text-brutal-gray">build {meta.version} / {meta.loadTime}</span>
        </div>

        <!-- Main headline -->
        <h1 class="font-display font-bold text-[clamp(2.5rem,8vw,7rem)] leading-[0.95] tracking-tighter mb-6 sm:mb-8">
          WE BUILD FAST,<br />
          <span class="text-brutal-accent">UNBREAKABLE</span><br />
          WEB SYSTEMS.
        </h1>

        <!-- Subheadline -->
        <p class="font-mono text-base sm:text-lg text-brutal-gray max-w-2xl mb-10 sm:mb-14 leading-relaxed">
          No bloat. No fluff. No framework drama. We engineer web applications that load instantly, scale reliably, and ship on time. Every year. Every project.
        </p>

        <!-- CTA buttons -->
        <div class="flex flex-wrap gap-4">
          <a
            href="#contact"
            class="font-display font-bold text-lg sm:text-xl px-8 py-4 bg-brutal-accent text-brutal-black border-4 border-brutal-accent hard-shadow hover:bg-brutal-white hover:border-brutal-white hover:translate-x-[3px] hover:translate-y-[3px] hover:shadow-none inline-block uppercase tracking-wider"
          >
            Start a Project →
          </a>
          <a
            href="#work"
            class="font-display font-bold text-lg sm:text-xl px-8 py-4 bg-brutal-black text-brutal-white border-4 border-brutal-white hard-shadow hover:bg-brutal-accent hover:border-brutal-accent hover:text-brutal-black hover:translate-x-[3px] hover:translate-y-[3px] hover:shadow-none inline-block uppercase tracking-wider"
          >
            View Work
          </a>
        </div>

        <!-- Scroll indicator -->
        <div class="absolute bottom-8 left-4 sm:left-8">
          <div class="mono-meta text-brutal-gray border-l-4 border-brutal-accent pl-3">
            <p class="uppercase tracking-wider">Scroll to explore</p>
            <p class="mt-1">↓</p>
          </div>
        </div>
      </div>
    </header>

    <!-- ═══════════════════ MARQUEE STRIP ═══════════════════ -->
    <div class="border-b-4 border-brutal-white bg-brutal-accent overflow-hidden">
      <div class="flex whitespace-nowrap py-3 animate-marquee">
        <span class="font-display font-bold text-brutal-black text-lg sm:text-xl mx-6 sm:mx-12 uppercase tracking-wider">
          ★ Custom Web Apps ★ API Engineering ★ Performance ★ Infrastructure ★
        </span>
        <span class="font-display font-bold text-brutal-black text-lg sm:text-xl mx-6 sm:mx-12 uppercase tracking-wider">
          ★ Custom Web Apps ★ API Engineering ★ Performance ★ Infrastructure ★
        </span>
        <span class="font-display font-bold text-brutal-black text-lg sm:text-xl mx-6 sm:mx-12 uppercase tracking-wider">
          ★ Custom Web Apps ★ API Engineering ★ Performance ★ Infrastructure ★
        </span>
        <span class="font-display font-bold text-brutal-black text-lg sm:text-xl mx-6 sm:mx-12 uppercase tracking-wider">
          ★ Custom Web Apps ★ API Engineering ★ Performance ★ Infrastructure ★
        </span>
      </div>
      <style>
        @keyframes marquee {
          0% { transform: translateX(0); }
          100% { transform: translateX(-50%); }
        }
        .animate-marquee {
          animation: marquee 20s linear infinite;
        }
      </style>
    </div>

    <!-- ═══════════════════ SERVICES SECTION ═══════════════════ -->
    <section id="services" class="border-b-4 border-brutal-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        <!-- Section header -->
        <div class="border-b-4 border-brutal-white py-8 sm:py-12">
          <span class="mono-meta text-brutal-accent block mb-2">// 01 — CAPABILITIES</span>
          <h2 class="font-display font-bold text-[clamp(2rem,5vw,4rem)] tracking-tight">
            WHAT WE <span class="text-brutal-accent">DO.</span>
          </h2>
        </div>

        <!-- Services grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 border-r-4 border-brutal-white">
          {services.map((service, i) => (
            <div class={[
              'p-6 sm:p-8 border-b-4 border-brutal-white',
              i % 2 === 0 ? 'border-r-4 border-brutal-white' : ''
            ].join(' ')}>
              <div class="flex items-center gap-3 mb-4">
                <span class="mono-meta text-brutal-accent text-xl font-bold">{service.icon}</span>
                <h3 class="font-display font-bold text-xl sm:text-2xl uppercase tracking-tight">{service.title}</h3>
              </div>
              <ul class="space-y-2">
                {service.bullets.map(bullet => (
                  <li class="font-mono text-sm text-brutal-gray">{bullet}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- ═══════════════════ SELECTED WORKS ═══════════════════ -->
    <section id="work" class="border-b-4 border-brutal-white bg-brutal-dark-gray">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        <!-- Section header -->
        <div class="border-b-4 border-brutal-white py-8 sm:py-12">
          <span class="mono-meta text-brutal-accent block mb-2">// 02 — SELECTED WORKS</span>
          <h2 class="font-display font-bold text-[clamp(2rem,5vw,4rem)] tracking-tight">
            BUILT. <span class="text-brutal-accent">NOT BLOATED.</span>
          </h2>
        </div>

        <!-- Project cards -->
        <div class="space-y-0">
          {projects.map((project, i) => (
            <div class={[
              'brutal-hover group border-b-4 border-brutal-white overflow-hidden',
              'hover:bg-brutal-black hover:text-brutal-black'
            ].join(' ')}>
              <div class="grid grid-cols-1 sm:grid-cols-12 gap-0">

                <!-- Project number / visual -->
                <div class="sm:col-span-2 border-r-4 border-brutal-white p-6 sm:p-8 group-hover:border-brutal-white flex flex-col items-start justify-between">
                  <span class="font-display font-bold text-6xl sm:text-7xl text-brutal-white group-hover:text-brutal-accent leading-none">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                </div>

                <!-- Project details -->
                <div class="sm:col-span-5 p-6 sm:p-8">
                  <span class="mono-meta text-brutal-accent block mb-2 group-hover:text-brutal-black">
                    {`// ${project.category}`}
                  </span>
                  <h3 class="font-display font-bold text-2xl sm:text-3xl uppercase tracking-tight mb-3 group-hover:text-brutal-accent">
                    {project.name}
                  </h3>
                  <p class="font-mono text-sm text-brutal-gray group-hover:text-brutal-dark-gray leading-relaxed">
                    {project.desc}
                  </p>
                </div>

                <!-- Project stats -->
                <div class="sm:col-span-5 border-l-4 border-brutal-white p-6 sm:p-8">
                  <div class="grid grid-cols-3 gap-4">
                    <div>
                      <p class="mono-meta text-brutal-accent mb-1 group-hover:text-brutal-black">LIGHTHOUSE</p>
                      <p class="font-display font-bold text-2xl group-hover:text-brutal-accent">{project.stats.lighthouse}</p>
                    </div>
                    <div>
                      <p class="mono-meta text-brutal-accent mb-1 group-hover:text-brutal-black">LOAD TIME</p>
                      <p class="font-display font-bold text-2xl group-hover:text-brutal-accent">{project.stats.loadTime}</p>
                    </div>
                    <div>
                      <p class="mono-meta text-brutal-accent mb-1 group-hover:text-brutal-black">BUNDLE</p>
                      <p class="font-display font-bold text-2xl group-hover:text-brutal-accent">{project.stats.bundleSize}</p>
                    </div>
                  </div>
                  <div class="mt-6 pt-4 border-t-2 border-brutal-white/20 group-hover:border-brutal-white/30">
                    <span class="mono-meta text-brutal-gray group-hover:text-brutal-black uppercase tracking-wider">
                      View Case Study →
                    </span>
                  </div>
                </div>

              </div>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- ═══════════════════ PHILOSOPHY / MANIFESTO ═══════════════════ -->
    <section id="philosophy" class="border-b-4 border-brutal-white grid-lines">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        <!-- Section header -->
        <div class="border-b-4 border-brutal-white py-8 sm:py-12">
          <span class="mono-meta text-brutal-accent block mb-2">// 03 — PHILOSOPHY</span>
          <h2 class="font-display font-bold text-[clamp(2rem,5vw,4rem)] tracking-tight">
            THE <span class="text-brutal-accent">MANIFESTO.</span>
          </h2>
        </div>

        <!-- Manifesto body -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-0">
          <!-- Left column: large pull quote -->
          <div class="lg:col-span-4 border-r-4 border-brutal-white p-6 sm:p-8 lg:p-10 flex flex-col justify-center">
            <p class="font-display font-bold text-3xl sm:text-4xl lg:text-5xl leading-tight tracking-tight">
              "The best technology is the technology that <span class="text-brutal-accent">gets out of the way.</span>"
            </p>
          </div>

          <!-- Right column: manifesto paragraphs -->
          <div class="lg:col-span-8">
            {manifesto.map((paragraph, i) => (
              <div class={[
                'p-6 sm:p-8 border-b-4 border-brutal-white',
                i === manifesto.length - 1 ? '' : ''
              ].join(' ')}>
                <span class="mono-meta text-brutal-accent block mb-3">
                  {`PARAGRAPH ${String(i + 1).padStart(2, '0')} / ${String(manifesto.length).padStart(2, '0')}`}
                </span>
                <p class="font-mono text-sm sm:text-base leading-relaxed text-brutal-gray">
                  {paragraph}
                </p>
              </div>
            ))}
          </div>
        </div>

      </div>
    </section>

    <!-- ═══════════════════ TERMINAL STATS STRIP ═══════════════════ -->
    <div class="border-b-4 border-brutal-white bg-brutal-accent">
      <div class="max-w-7xl mx-auto grid grid-cols-2 sm:grid-cols-4">
        <div class="p-6 sm:p-8 border-r-4 border-brutal-white flex flex-col items-center text-center">
          <span class="font-display font-bold text-4xl sm:text-5xl text-brutal-black">147</span>
          <span class="mono-meta text-brutal-black uppercase tracking-wider mt-2">Projects Shipped</span>
        </div>
        <div class="p-6 sm:p-8 border-r-4 border-brutal-white flex flex-col items-center text-center">
          <span class="font-display font-bold text-4xl sm:text-5xl text-brutal-black">99.9%</span>
          <span class="mono-meta text-brutal-black uppercase tracking-wider mt-2">Uptime SLA</span>
        </div>
        <div class="p-6 sm:p-8 border-r-4 border-brutal-white flex flex-col items-center text-center">
          <span class="font-display font-bold text-4xl sm:text-5xl text-brutal-black">&lt;50ms</span>
          <span class="mono-meta text-brutal-black uppercase tracking-wider mt-2">Avg TTFB</span>
        </div>
        <div class="p-6 sm:p-8 flex flex-col items-center text-center">
          <span class="font-display font-bold text-4xl sm:text-5xl text-brutal-black">0</span>
          <span class="mono-meta text-brutal-black uppercase tracking-wider mt-2">Bloat Dependencies</span>
        </div>
      </div>
    </div>

    <!-- ═══════════════════ CONTACT / FOOTER TERMINAL ═══════════════════ -->
    <section id="contact" class="border-b-4 border-brutal-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        <!-- Section header -->
        <div class="border-b-4 border-brutal-white py-8 sm:py-12">
          <span class="mono-meta text-brutal-accent block mb-2">// 04 — INITIATE PROJECT</span>
          <h2 class="font-display font-bold text-[clamp(2rem,5vw,4rem)] tracking-tight">
            LET'S <span class="text-brutal-accent">BUILD.</span>
          </h2>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-0">

          <!-- Contact form -->
          <div class="border-r-4 border-brutal-white p-6 sm:p-8 lg:p-10">
            <form class="space-y-6" action="/api/contact" method="POST">
              <div>
                <label class="mono-meta text-brutal-accent block mb-2 uppercase">
                  &gt; name:
                </label>
                <input
                  type="text"
                  name="name"
                  required
                  class="w-full bg-brutal-dark-gray border-4 border-brutal-white px-4 py-3 font-mono text-sm text-brutal-white placeholder-brutal-gray focus:border-brutal-accent focus:outline-none hard-shadow-sm"
                  placeholder="your name"
                />
              </div>
              <div>
                <label class="mono-meta text-brutal-accent block mb-2 uppercase">
                  &gt; email:
                </label>
                <input
                  type="email"
                  name="email"
                  required
                  class="w-full bg-brutal-dark-gray border-4 border-brutal-white px-4 py-3 font-mono text-sm text-brutal-white placeholder-brutal-gray focus:border-brutal-accent focus:outline-none hard-shadow-sm"
                  placeholder="you@company.com"
                />
              </div>
              <div>
                <label class="mono-meta text-brutal-accent block mb-2 uppercase">
                  &gt; project:
                </label>
                <textarea
                  name="project"
                  rows="4"
                  required
                  class="w-full bg-brutal-dark-gray border-4 border-brutal-white px-4 py-3 font-mono text-sm text-brutal-white placeholder-brutal-gray focus:border-brutal-accent focus:outline-none hard-shadow-sm resize-none"
                  placeholder="describe your project..."
                ></textarea>
              </div>
              <div>
                <label class="mono-meta text-brutal-accent block mb-2 uppercase">
                  &gt; budget:
                </label>
                <select
                  name="budget"
                  class="w-full bg-brutal-dark-gray border-4 border-brutal-white px-4 py-3 font-mono text-sm text-brutal-white focus:border-brutal-accent focus:outline-none hard-shadow-sm appearance-none"
                >
                  <option value="">select range</option>
                  <option value="10-25k">$10k — $25k</option>
                  <option value="25-50k">$25k — $50k</option>
                  <option value="50-100k">$50k — $100k</option>
                  <option value="100k+">$100k+</option>
                </select>
              </div>
              <button
                type="submit"
                class="w-full font-display font-bold text-lg px-8 py-4 bg-brutal-accent text-brutal-black border-4 border-brutal-accent hard-shadow hover:bg-brutal-white hover:border-brutal-white hover:translate-x-[3px] hover:translate-y-[3px] hover:shadow-none uppercase tracking-wider"
              >
                INITIATE PROJECT →
              </button>
            </form>
          </div>

          <!-- Terminal output -->
          <div class="p-6 sm:p-8 lg:p-10 bg-brutal-dark-gray">
            <div class="font-mono text-sm sm:text-base">
              <!-- Terminal header -->
              <div class="flex items-center gap-2 mb-6 pb-4 border-b-2 border-brutal-white/20">
                <div class="w-3 h-3 rounded-full bg-red-500 border border-red-700"></div>
                <div class="w-3 h-3 rounded-full bg-yellow-500 border border-yellow-700"></div>
                <div class="w-3 h-3 rounded-full bg-green-500 border border-green-700"></div>
                <span class="ml-2 mono-meta text-brutal-gray">build.co — project-init</span>
              </div>
              <!-- Terminal lines -->
              {contactLines.map((line, i) => (
                <p class={[
                  'mb-2',
                  line.startsWith('$') ? 'text-brutal-accent' :
                  line.startsWith('>') ? 'text-brutal-white' :
                  i === contactLines.length - 1 ? 'text-brutal-white cursor-blink' : 'text-brutal-gray'
                ].join(' ')}>
                  {line}
                </p>
              ))}
            </div>

            <!-- System info -->
            <div class="mt-10 pt-6 border-t-2 border-brutal-white/20">
              <h4 class="mono-meta text-brutal-accent uppercase tracking-wider mb-4">system details</h4>
              <div class="grid grid-cols-2 gap-4">
                <div>
                  <span class="mono-meta text-brutal-gray block">server</span>
                  <span class="font-mono text-sm">US-East-1</span>
                </div>
                <div>
                  <span class="mono-meta text-brutal-gray block">stack</span>
                  <span class="font-mono text-sm">Astro / TS / Tailwind</span>
                </div>
                <div>
                  <span class="mono-meta text-brutal-gray block">memory</span>
                  <span class="font-mono text-sm">4.2mb footprint</span>
                </div>
                <div>
                  <span class="mono-meta text-brutal-gray block">response</span>
                  <span class="font-mono text-sm">&lt; 24 hours</span>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ═══════════════════ FOOTER ═══════════════════ -->
