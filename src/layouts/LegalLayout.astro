---
import BaseLayout from './BaseLayout.astro';

interface Props {
  frontmatter: {
    title: string;
    lastUpdate: Date;
  };
}

const { frontmatter } = Astro.props;
---

<BaseLayout title={frontmatter.title}>
  <section class="max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
    <div class="mb-12 sm:mb-16">
      <span class="mono-meta text-brutal-accent block mb-2">// LEGAL</span>
      <h1 class="font-display font-bold text-[clamp(2.5rem,6vw,5rem)] tracking-tight leading-[0.9] mb-4 uppercase">
        {frontmatter.title}
      </h1>
      <p class="font-mono text-sm sm:text-base text-brutal-gray max-w-xl">
        Last updated: {new Date(frontmatter.lastUpdate).toLocaleDateString()}.
      </p>
    </div>
    <slot />
  </section>
</BaseLayout>

<style is:global>
  @reference "../styles/global.css";

  h2,
  h3 {
    @apply text-brutal-white py-6 font-mono text-xs tracking-wider;
  }
  h2 {
    @apply text-brutal-accent border-brutal-white mt-12 border-t-4;
  }

  p,
  li,
  pre {
    @apply text-brutal-gray mb-6 font-mono text-sm leading-relaxed sm:text-base;
  }

  li {
    @apply list-inside list-disc;
  }

  pre {
    @apply p-6;
  }

  a {
    @apply text-brutal-white hover:text-brutal-accent
  }
</style>
