---
const prompt = 'user@web-01';
---

<section id="contact" class="border-b-4 border-brutal-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section header -->
    <div class="border-b-4 border-brutal-white py-8 sm:py-12">
      <span class="mono-meta text-brutal-accent block mb-2">
        // 04 — INITIATE PROJECT
      </span>
      <h2 class="font-display font-bold text-[clamp(2rem,5vw,4rem)] tracking-tight">
        LET'S <span class="text-brutal-accent">BUILD.</span>
      </h2>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-0">
      <!-- Contact form -->
      <div class="p-6 sm:p-8 lg:p-10">
        <form class="space-y-6" method="POST" id="contact-form">
          <input type="hidden" name="access_key" value="WEB3FORM_ACCESS_KEY" />
          <div>
            <label class="mono-meta text-brutal-accent block mb-2 uppercase">
              &gt; name:
            </label>
            <input
              type="text"
              name="name"
              required
              class="w-full bg-brutal-dark-gray border-4 border-brutal-white px-4 py-3 font-mono text-sm text-brutal-white placeholder-brutal-gray focus:border-brutal-accent focus:outline-none shadow-hard-sm"
              placeholder="your name"
            />
          </div>
          <div>
            <label class="mono-meta text-brutal-accent block mb-2 uppercase">
              &gt; email:
            </label>
            <input
              type="email"
              name="email"
              required
              class="w-full bg-brutal-dark-gray border-4 border-brutal-white px-4 py-3 font-mono text-sm text-brutal-white placeholder-brutal-gray focus:border-brutal-accent focus:outline-none shadow-hard-sm"
              placeholder="you@company.com"
            />
          </div>
          <div>
            <label class="mono-meta text-brutal-accent block mb-2 uppercase">
              &gt; project:
            </label>
            <textarea
              name="project"
              rows="4"
              required
              class="w-full bg-brutal-dark-gray border-4 border-brutal-white px-4 py-3 font-mono text-sm text-brutal-white placeholder-brutal-gray focus:border-brutal-accent focus:outline-none shadow-hard-sm resize-none"
              placeholder="describe your project..."
            ></textarea>
          </div>
          <div>
            <label class="mono-meta text-brutal-accent block mb-2 uppercase">
              &gt; budget:
            </label>
            <select
              name="budget"
              class="w-full bg-brutal-dark-gray border-4 border-brutal-white px-4 py-3 font-mono text-sm text-brutal-white focus:border-brutal-accent focus:outline-none shadow-hard-sm appearance-none"
            >
              <option value="">select range</option>
              <option value="10-25k">$10k — $25k</option>
              <option value="25-50k">$25k — $50k</option>
              <option value="50-100k">$50k — $100k</option>
              <option value="100k+">$100k+</option>
            </select>
          </div>
          <button
            type="submit"
            class="w-full font-display font-bold text-lg px-8 py-4 bg-brutal-accent text-brutal-black border-4 border-brutal-accent shadow-hard hover:bg-brutal-white hover:border-brutal-white hover:translate-x-0.75 hover:translate-y-0.75 hover:shadow-none uppercase tracking-wider"
          >
            INITIATE PROJECT →
          </button>
        </form>
      </div>

      <!-- Terminal output -->
      <div class="mt-10 bg-brutal-dark-gray text-brutal-gray border border-brutal-dark-gray rounded-t-lg overflow-hidden min-h-96">
        <!-- Terminal header -->
        <div class="flex items-center gap-2 p-3 border-b-2 border-brutal-white/20 bg-brutal-black">
          <div class="w-3 h-3 rounded-full bg-red-500 border border-red-700"></div>
          <div class="w-3 h-3 rounded-full bg-yellow-500 border border-yellow-700"></div>
          <div class="w-3 h-3 rounded-full bg-green-500 border border-green-700"></div>
          <span class="ml-2 mono-meta text-brutal-gray">{prompt} ~</span>
        </div>
        <div
          class="font-mono text-sm p-1 *:my-0.5 *:last:after:content-['█'] *:last:after:animate-blink"
          id="contact-terminal"
          data-prompt={prompt}
        >
          <!-- Terminal lines -->
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    async function submit(data: Record<string, FormDataEntryValue>) {
      try {
        const r = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json',
          },
          body: JSON.stringify(data),
        });
        const result = await r.json();
        console.log(result);
        return result.message;
      } catch (e) {
        console.log(e);
        return 'Unknown error encountered';
      }
    }

    document.addEventListener('DOMContentLoaded', function () {
      let lastPrompt: HTMLPreElement | null = null;

      const form = document.querySelector<HTMLFormElement>('#contact-form');
      const terminal =
        document.querySelector<HTMLDivElement>('#contact-terminal');

      function addStdout(text: string) {
        const pre = document.createElement('pre');
        pre.textContent = text;
        terminal?.append(pre);
      }

      function addPrompt() {
        const pre = document.createElement('pre');
        const span = document.createElement('span');
        span.textContent = terminal?.dataset.prompt || '';
        span.className = 'text-brutal-dark-accent';
        pre.textContent = ':~$ ';
        pre.prepend(span);
        terminal?.append(pre);
        lastPrompt = pre;
      }

      function addCommand(text: string) {
        if (!lastPrompt) {
          return;
        }

        lastPrompt.append(text);
      }

      function clearTerminal() {
        if (!terminal) {
          return;
        }
        terminal.innerHTML = '';
      }

      if (!form || !terminal) {
        return;
      }

      clearTerminal();
      addStdout('Last login: Thu Jan 1 00:00:00 1970 on pts/0');
      addPrompt();

      form?.addEventListener('submit', async function (e) {
        e.preventDefault();
        const formData = new FormData(form);
        const data = Object.fromEntries(formData);
        console.log(data);
        addCommand('./init-project');
        addStdout('COLLECTED INPUT');
        addStdout('---------------');
        addStdout(`> Name:    ${data.name}`);
        addStdout(`> Email:   ${data.email}`);
        addStdout(`> Project: [text]`);
        addStdout(' ');
        addStdout('Sending...');

        const message = await submit(data);
        addStdout(message);
        addPrompt();
      });
    });
  })();
</script>
