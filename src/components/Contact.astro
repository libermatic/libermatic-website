---
import { WEB3FORM_ACCESS_KEY } from 'astro:env/client';

const prompt = 'user@web-01';
---

<section id="contact" class="border-b-4 border-brutal-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section header -->
    <div class="border-b-4 border-brutal-white py-8 sm:py-12">
      <span class="mono-meta text-brutal-accent block mb-2">
        // 04 — INITIATE PROJECT
      </span>
      <h2 class="font-display font-bold text-[clamp(2rem,5vw,4rem)] tracking-tight">
        LET'S <span class="text-brutal-accent">BUILD.</span>
      </h2>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-0">
      <!-- Contact form -->
      <div class="p-6 sm:p-8 lg:p-10">
        <form class="space-y-6" method="POST" id="contact-form">
          <input type="hidden" name="access_key" value={WEB3FORM_ACCESS_KEY} />
          <div>
            <label class="mono-meta text-brutal-accent block mb-2 uppercase">
              &gt; name:
            </label>
            <input
              type="text"
              name="name"
              required
              class="w-full bg-brutal-dark-gray border-4 border-brutal-white px-4 py-3 font-mono text-sm text-brutal-white placeholder-brutal-gray focus:border-brutal-accent focus:outline-none shadow-hard-sm"
              placeholder="your name"
            />
          </div>
          <div>
            <label class="mono-meta text-brutal-accent block mb-2 uppercase">
              &gt; email:
            </label>
            <input
              type="email"
              name="email"
              required
              class="w-full bg-brutal-dark-gray border-4 border-brutal-white px-4 py-3 font-mono text-sm text-brutal-white placeholder-brutal-gray focus:border-brutal-accent focus:outline-none shadow-hard-sm"
              placeholder="you@company.com"
            />
          </div>
          <div>
            <label class="mono-meta text-brutal-accent block mb-2 uppercase">
              &gt; project:
            </label>
            <textarea
              name="project"
              rows="4"
              required
              class="w-full bg-brutal-dark-gray border-4 border-brutal-white px-4 py-3 font-mono text-sm text-brutal-white placeholder-brutal-gray focus:border-brutal-accent focus:outline-none shadow-hard-sm resize-none"
              placeholder="describe your project..."
            ></textarea>
          </div>
          <button
            type="submit"
            class="w-full font-display font-bold text-lg px-8 py-4 bg-brutal-accent text-brutal-black border-4 border-brutal-accent shadow-hard hover:bg-brutal-white hover:border-brutal-white hover:translate-x-0.75 hover:translate-y-0.75 hover:shadow-none uppercase tracking-wider"
          >
            INITIATE PROJECT →
          </button>
        </form>
      </div>

      <!-- Terminal output -->
      <div class="mt-10 relative">
        <div class="lg:absolute lg:inset-0 flex flex-col">
          <!-- Terminal header -->
          <div class="shrink-0 flex items-center gap-2 p-3 border border-brutal-white/20 bg-brutal-black rounded-t-lg">
            <div class="w-3 h-3 rounded-full bg-red-500 border border-red-700"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-500 border border-yellow-700"></div>
            <div class="w-3 h-3 rounded-full bg-green-500 border border-green-700"></div>
            <span class="ml-2 mono-meta text-brutal-gray">{prompt} ~</span>
          </div>
          <div
            class="h-96 lg:h-auto lg:flex-1 min-h-0 overflow-y-auto scrollbar-none [&::-webkit-scrollbar]:hidden bg-brutal-dark-gray text-brutal-gray font-mono text-sm p-1 *:my-0.5 *:whitespace-pre-wrap *:last:after:content-['█'] *:last:after:animate-blink"
            id="contact-terminal"
            data-prompt={prompt}
          >
            <!-- Terminal lines -->
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    interface SubmitResult {
      status: 'success' | 'fail';
      message: string;
    }

    async function submit(
      data: Record<string, FormDataEntryValue>
    ): Promise<SubmitResult> {
      try {
        const r = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json',
          },
          body: JSON.stringify(data),
        });

        if (r.status === 200) {
          return {
            status: 'success',
            message: 'Data captured. Response in ~24h',
          };
        }

        return {
          status: 'fail',
          message: `[${r.status}] Error capturing data`,
        };
      } catch (e) {
        console.log(e);
        return { status: 'fail', message: 'Unknown error encountered' };
      }
    }

    document.addEventListener('DOMContentLoaded', async function () {
      let lastPrompt: HTMLPreElement | null = null;

      const form = document.querySelector<HTMLFormElement>('#contact-form');
      const terminal =
        document.querySelector<HTMLDivElement>('#contact-terminal');

      const BASE_SPEED = 20;
      const JITTER = 15;

      function randRange(min: number, max: number) {
        return Math.floor(Math.random() * (max - min + 1)) + min;
      }

      function sleep(ms: number) {
        return new Promise((r) => setTimeout(r, ms));
      }

      // Shared async queue to serialize typing
      let queue: Promise<any> = Promise.resolve();

      function enqueue<T>(fn: () => Promise<T>): Promise<T> {
        return (queue = queue.then(fn));
      }

      async function typeChars(source: HTMLElement, text: string) {
        for (let i = 0; i < text.length; i++) {
          source.append(text[i]);
          await sleep(randRange(BASE_SPEED - JITTER, BASE_SPEED + JITTER));
        }
      }

      async function addStdout(
        text: string,
        className: string = ''
      ): Promise<HTMLPreElement> {
        return enqueue(async () => {
          const pre = document.createElement('pre');
          pre.className = className;
          terminal?.append(pre);
          await typeChars(pre, text);
          scrollToBottom();
          return pre;
        });
      }

      async function replaceStdout(
        pre: HTMLPreElement,
        text: string,
        className: string = ''
      ): Promise<HTMLPreElement> {
        return enqueue(async () => {
          pre.textContent = '';
          pre.className = className;
          await typeChars(pre, text);
          scrollToBottom();
          return pre;
        });
      }

      async function addCommand(text: string) {
        return enqueue(async () => {
          if (!lastPrompt) return;
          await typeChars(lastPrompt, text);
          scrollToBottom();
          return lastPrompt;
        });
      }

      function addPrompt() {
        const pre = document.createElement('pre');
        const span = document.createElement('span');
        span.textContent = terminal?.dataset.prompt || '';
        span.className = 'text-brutal-dark-accent';
        pre.textContent = ':~$ ';
        pre.prepend(span);
        terminal?.append(pre);
        lastPrompt = pre;
      }

      function maskEmail(email: string): string {
        const [user, domain] = email.split('@');
        const masked = user[0] ? user[0] + '*'.repeat(user.length - 1) : '';
        return `${masked}@${domain}`;
      }

      function clearTerminal() {
        if (!terminal) {
          return;
        }
        terminal.innerHTML = '';
      }

      function scrollToBottom() {
        if (!terminal) return;
        terminal.scrollTop = terminal.scrollHeight;
      }

      if (!form || !terminal) {
        return;
      }

      clearTerminal();
      await addStdout('Last login: Thu Jan 1 00:00:00 1970 on pts/0');
      addPrompt();

      form?.addEventListener('submit', async function (e) {
        e.preventDefault();
        await addCommand('./init-project');

        const formData = new FormData(form);
        const data = Object.fromEntries(formData);
        await addStdout('COLLECTED INPUT');
        await addStdout('---------------');
        await addStdout(`> Name:    ${data.name}`);
        await addStdout(`> Email:   ${maskEmail(data.email as string)}`);
        await addStdout(`> Project: [text]`);
        await addStdout(' ');
        const loadningRef = await addStdout(' Uploading', 'braille-spinner');
        const { status, message } = await submit(data);
        await replaceStdout(
          loadningRef,
          status === 'success' ? '✓ Upload successful' : '✗ Upload failed',
          ''
        );
        await addStdout(message, status === 'success' ? '' : 'text-red-300');
        addPrompt();
      });
    });
  })();
</script>
