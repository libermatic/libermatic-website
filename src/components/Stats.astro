---
import type { Stat } from './types';

const statItems: Stat[] = [
  { label: 'Clients Served', value: '30+' },
  { label: 'Ongoing Support', value: '15+' },
  { label: 'ERPNext Projects', value: '10+' },
  { label: 'Other Projects', value: '25+' },
];
---

<div class="border-b-4 border-brutal-white bg-brutal-accent">
  <div class="max-w-7xl mx-auto grid grid-cols-2 sm:grid-cols-4">
    {statItems.map((stat, i) => (
      <div
        class:list={[
          'p-6 sm:p-8 flex flex-col items-center text-center',
          { 'border-r-4 border-brutal-white': i % 2 === 0 },
          { 'sm:border-r-4 border-brutal-white': i < statItems.length - 1 },
          { 'border-b-4 border-brutal-white sm:border-b-0': i < 2 },
        ]}
      >
        <span class="font-display font-bold text-4xl sm:text-5xl text-brutal-black">
          {stat.value}
        </span>
        <span class="mono-meta text-brutal-black uppercase tracking-wider mt-2">
          {stat.label}
        </span>
      </div>
    ))}
  </div>
</div>
