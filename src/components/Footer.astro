---
import Logo from '../assets/logo.svg';
---

<footer class="border-b-4 border-brutal-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <span class="text-brutal-accent">
          <Logo class="w-5 h-5" />
        </span>
        <span class="font-display font-bold text-lg tracking-tight">
          LIBERMATIC<span class="text-brutal-accent">.</span>
        </span>
      </div>
      <div class="mono-meta text-brutal-gray flex flex-wrap gap-4 sm:gap-6 items-center">
        <span>© {new Date().getFullYear()} LIBERMATIC.</span>
        <span class="hidden sm:inline">|</span>
        <span>SYS:v2.4.1</span>
        <span class="hidden sm:inline">|</span>
        <span>MEM:4.2mb</span>
      </div>
      <div class="flex gap-4">
        <a
          href="#"
          class="w-10 h-10 border-2 border-brutal-white flex items-center justify-center hover:bg-brutal-accent hover:border-brutal-accent hover:text-brutal-black transition-colors shadow-hard-sm"
          aria-label="GitHub"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
          </svg>
        </a>
        <a
          href="#"
          class="w-10 h-10 border-2 border-brutal-white flex items-center justify-center hover:bg-brutal-accent hover:border-brutal-accent hover:text-brutal-black transition-colors shadow-hard-sm"
          aria-label="Twitter"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
          </svg>
        </a>
      </div>
    </div>
    <hr class="accent-hr mt-8 mb-6" />
    <p class="mono-meta text-brutal-gray text-xs uppercase tracking-wider">
      All signal. No noise. Fully operational.
    </p>
  </div>
</footer>
