---
import { version } from '../../package.json';
---

<header class="relative min-h-screen flex flex-col justify-center border-b-4 border-brutal-white grid-lines pt-16">
  <div class="max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-12 sm:py-20">
    <!-- Metadata bar -->
    <div class="flex flex-wrap gap-3 sm:gap-4 mb-8 sm:mb-12">
      <span class="mono-meta px-3 py-1 border-2 border-brutal-accent text-brutal-accent">
        <span id="m-tz">--</span>
      </span>
      <span class="mono-meta px-3 py-1 border-2 border-brutal-white text-brutal-white">
        <span id="m-conn">--</span>: load <span id="m-load">--</span> / lcp{' '}
        <span id="m-lcp">--</span>
      </span>
      <span class="mono-meta px-3 py-1 border-2 border-brutal-white text-brutal-white">
        wt <span id="m-xfer-wt">--</span> / <span id="m-wt">--</span>
      </span>
      <span class="mono-meta px-3 py-1 border-2 border-brutal-dark-gray text-brutal-gray">
        build <span id="m-build">{version}</span>
      </span>
    </div>

    <!-- Main headline -->
    <h1 class="font-display font-bold text-[clamp(2.5rem,8vw,7rem)] leading-[0.95] tracking-tighter mb-6 sm:mb-8">
      WE BUILD FAST,
      <br />
      <span class="text-brutal-accent">UNBREAKABLE</span>
      <br />
      WEB SYSTEMS.
    </h1>

    <!-- Subheadline -->
    <p class="font-mono text-base sm:text-lg text-brutal-gray max-w-2xl mb-10 sm:mb-14 leading-relaxed">
      No bloat. No fluff. No framework drama. We engineer web applications that
      load instantly, scale reliably, and ship on time. Every year. Every
      project.
    </p>

    <!-- CTA buttons -->
    <div class="flex flex-wrap gap-4">
      <a
        href="#contact"
        class="font-display font-bold text-lg sm:text-xl px-8 py-4 bg-brutal-accent text-brutal-black border-4 border-brutal-accent shadow-hard hover:bg-brutal-white hover:border-brutal-white hover:translate-x-0.75 hover:translate-y-0.75 hover:shadow-none inline-block uppercase tracking-wider"
      >
        Start a Project →
      </a>
      <a
        href="#work"
        class="font-display font-bold text-lg sm:text-xl px-8 py-4 bg-brutal-black text-brutal-white border-4 border-brutal-white shadow-hard hover:bg-brutal-accent hover:border-brutal-accent hover:text-brutal-black hover:translate-x-0.75 hover:translate-y-0.75 hover:shadow-none inline-block uppercase tracking-wider"
      >
        View Work
      </a>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-4 sm:left-8">
      <div class="mono-meta text-brutal-gray border-l-4 border-brutal-accent pl-3">
        <p class="uppercase tracking-wider">Scroll to explore</p>
        <p class="mt-1">↓</p>
      </div>
    </div>

    <!-- Runtime metrics -->
    <script>
      (function () {
        const el = (id: string) => document.getElementById(id)!;
        // Timezone
        const parts = new Date()
          .toLocaleString('en-US', { timeZoneName: 'short' })
          .split(' ')
          .slice(-1)[0];
        el('m-tz').textContent = parts;

        // Network type
        const conn = (navigator as Navigator & { connection?: any }).connection;
        if (conn) {
          el('m-conn').textContent = conn.effectiveType || 'unknown';
          conn.addEventListener('change', () => {
            el('m-conn').textContent = conn.effectiveType || 'unknown';
          });
        }

        // Page weight (decoded) & transfer
        const resources = performance.getEntriesByType(
          'resource'
        ) as PerformanceResourceTiming[];
        let total = 0;
        let xferTotal = 0;
        for (let i = 0; i < resources.length; i++) {
          total += resources[i].encodedBodySize || 0;
          xferTotal += resources[i].transferSize || 0;
        }
        const fmt = (bytes: number) =>
          bytes > 1024 ? (bytes / 1024).toFixed(1) + 'kb' : bytes + 'b';
        el('m-wt').textContent = fmt(total);
        el('m-xfer-wt').textContent = fmt(xferTotal);

        // Load time
        window.addEventListener('load', function () {
          const nav = performance.getEntriesByType('navigation')[0];
          setTimeout(() => {
            if (nav) {
              el('m-load').textContent = Math.round(nav.duration) + 'ms';
            }
          }, 0);
        });

        // LCP
        new PerformanceObserver(function (entryList) {
          const entries = entryList.getEntries();
          for (let j = 0; j < entries.length; j++) {
            el('m-lcp').textContent = Math.round(entries[j].startTime) + 'ms';
          }
        }).observe({ type: 'largest-contentful-paint', buffered: true });
      })();
    </script>
  </div>
</header>
