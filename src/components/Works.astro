---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';

const projects = await getCollection('projects').then((col) =>
  col
    .filter((x) => x.data.featureOrder)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .sort(
      (a, b) =>
        (a.data.featureOrder?.valueOf() ?? 0) -
        (b.data.featureOrder?.valueOf() ?? 0)
    )
);
---

<section
  id="work"
  class="border-b-4 border-brutal-white bg-brutal-dark-gray pb-12 sm:pb-16"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section header -->
    <div class="py-8 sm:py-12">
      <span class="mono-meta text-brutal-accent block mb-2">
        // 02 — SELECTED WORKS
      </span>
      <h2 class="font-display font-bold text-[clamp(2rem,5vw,4rem)] tracking-tight">
        BUILT. <span class="text-brutal-accent">NOT BLOATED.</span>
      </h2>
    </div>

    <!-- Project cards -->
    <div class="border-t-4 border-brutal-white *:border-b-4 *:border-brutal-white space-y-0">
      {projects.map((project, i) => (
        <ProjectCard index={i} slug={project.id} project={project.data} />
      ))}
    </div>
  </div>
</section>
